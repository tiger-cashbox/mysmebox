# MySMEBox v1 — ค่าตั้งสำหรับ production ผ่าน docker compose (ค่าปลอมทั้งหมด ห้าม commit .env.prod)
# ใช้: cp .env.prod.example .env.prod แล้วแก้ค่าจริง จากนั้น
#      docker compose --env-file .env.prod up -d --build
# ไม่ต้องตั้ง DATABASE_URL / PG_HOST / HOST — docker-compose.yml กำหนดเอง
# ไม่มี MinIO ใน compose: อัปโหลดรูปสินค้า/สลิปตอบ 503 STORAGE_DISABLED ส่วนอื่นใช้ได้ปกติ
# ไม่มี Google Login: ปุ่ม Google ปิด เข้าใช้ได้เฉพาะร้านทดลอง
# ไม่มี AI (Ollama): ฟีเจอร์ AI ตอบ 503 AI_DISABLED

NODE_ENV=production
PORT=8500
# app ใน compose เสิร์ฟ public/ เอง ; ตั้ง 0 เฉพาะเมื่อ Caddy เข้าถึงโฟลเดอร์ public/ และเสิร์ฟเองแล้ว
SERVE_STATIC=1
# ต้องตรงกับ URL ที่เปิดใน browser ทุกตัว (scheme + host + port, กัน CSRF) ห้ามว่างใน production
APP_ORIGIN=https://app.example.com
# ว่าง = true (HTTPS) ; ถ้าเข้าผ่าน http เช่น http://<IP>:8500 ต้องตั้ง 0 ไม่งั้น login ไม่ได้
COOKIE_SECURE=

# PostgreSQL (สร้าง DB/user ให้ตอนสตาร์ทครั้งแรก) — ไม่เปิด port ออก host, app ต่อผ่าน network ภายใน compose
PG_DATABASE=mysmebox
PG_USER=mysmebox
PG_PASSWORD=change_me_to_a_long_random_password # pragma: allowlist secret
